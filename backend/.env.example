# Variables d'environnement — copier ce fichier en .env et remplir les valeurs
# .env est ignoré par git ; .env.example est commité comme référence

# ── Variables normales ──────────────────────────────────────────────────────
# Nom de l'application affiché dans les logs et les réponses API
APP_NAME=appName

# Port d'écoute (Cloud Run impose 8080 en prod, laisser vide pour utiliser la valeur par défaut)
# PORT=8080

# Origine autorisée pour les requêtes cross-origin (CORS)
# En dev : http://localhost:5173 (serveur Vite)
# En prod : URL Firebase Hosting, ex. https://test-cloud-run-999.web.app
ALLOWED_ORIGIN=http://localhost:5173

# ID du projet GCP (détecté automatiquement sur Cloud Run, requis en local)
GOOGLE_CLOUD_PROJECT=projectId

# ── Secrets (via Google Secret Manager en prod) ─────────────────────────────
# En local : mettre la valeur directement ici
# En prod  : NE PAS mettre ici — injecté automatiquement par Cloud Run (voir README)
API_SECRET_KEY=ma-super-clé-secrète

# Clé secrète pour signer les tokens JWT
JWT_SECRET=mon-secret-jwt
